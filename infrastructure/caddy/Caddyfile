# Production web server for WearVerse (HTTPS is automatic with Caddy).
# Set WEARVERSE_DOMAIN and point DNS at this server. The built web app is in /srv/web (apps/web/dist).
{$WEARVERSE_DOMAIN:localhost} {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"

	handle /api/* {
		reverse_proxy api:8000
	}
	handle /sitemap.xml {
		rewrite * /api/v1/store/sitemap.xml
		reverse_proxy api:8000
	}
	handle /robots.txt {
		rewrite * /api/v1/store/robots.txt
		reverse_proxy api:8000
	}

	# Search-engine and link-preview bots get server-rendered HTML (title, description, JSON-LD);
	# people get the normal React app.
	@bot_product {
		header_regexp User-Agent (?i)(googlebot|bingbot|duckduckbot|yandex|baiduspider|facebookexternalhit|twitterbot|whatsapp|linkedinbot|slurp)
		path_regexp product ^/product/([0-9a-f-]+)$
	}
	handle @bot_product {
		rewrite * /api/v1/store/seo/product/{re.product.1}
		reverse_proxy api:8000
	}
	@bot_category {
		header_regexp User-Agent (?i)(googlebot|bingbot|duckduckbot|yandex|baiduspider|facebookexternalhit|twitterbot|whatsapp|linkedinbot|slurp)
		path_regexp category ^/(sarees|suits|kids)$
	}
	handle @bot_category {
		rewrite * /api/v1/store/seo/category/{re.category.1}
		reverse_proxy api:8000
	}

	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		root * /srv/web
		file_server
	}
	handle {
		root * /srv/web
		try_files {path} /index.html
		file_server
	}
}
