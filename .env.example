# WearVerse environment. Copy to apps/api/.env (API) and set the same keys for the worker / AI service.
# Never commit real values. Staging and production keep these in a secrets manager.

APP_NAME="WearVerse API"
ENVIRONMENT=local                      # local | dev | staging | production
PUBLIC_WEB_URL=http://localhost:5173   # used in Pay Now links sent on WhatsApp
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database and queue (DB credentials match docker-compose.yml)
DATABASE_URL=postgresql+psycopg://fashionos:fashionos@localhost:5432/fashionos
REDIS_URL=redis://localhost:6379/0

# Tokens: use long random strings (openssl rand -hex 32)
JWT_SECRET=
PAYLINK_SECRET=

# Tally sync agent (same value in apps/tally-bridge/config/tally-bridge.local.yaml)
TALLY_AGENT_API_KEY=

# Celery worker -> API scheduled jobs (/api/v1/internal/*)
INTERNAL_API_KEY=
API_INTERNAL_URL=http://localhost:8000/api/v1/internal

# Razorpay. Empty = local test mode (payments simulated; never on staging/production)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# WhatsApp Business API provider. Empty = log provider (messages only logged)
WHATSAPP_PROVIDER_URL=
WHATSAPP_API_KEY=
WHATSAPP_WEBHOOK_SECRET=

# SMS / OTP (2factor.in)
TWOFACTOR_API_KEY=
CUSTOMER_OTP_TEST_MODE=true

# Google sign-in for website customers: OAuth 2.0 Web client id from console.cloud.google.com
# (Authorised JavaScript origins: your site URL, e.g. http://localhost:5173). Empty = Google button off.
GOOGLE_CLIENT_ID=

# Courier (empty = staff enter AWB by hand)
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=

# Product images (Cloudflare R2, S3 compatible)
IMAGE_STORAGE_PROVIDER=r2
IMAGE_STORAGE_BUCKET=
IMAGE_STORAGE_ENDPOINT=
IMAGE_STORAGE_REGION=auto
IMAGE_STORAGE_ACCESS_KEY=
IMAGE_STORAGE_SECRET_KEY=
IMAGE_STORAGE_PUBLIC_BASE_URL=
IMAGE_STORAGE_MAX_FILE_SIZE_MB=5

# AI service (apps/ai-service). The API calls it with a 3 s timeout and falls back to templates.
AI_SERVICE_URL=http://localhost:8001
ANTHROPIC_API_KEY=                     # empty = AI wording off, standard templates used
AI_MODEL_TEXT=claude-opus-5-5

# Production web server (Caddy, docker compose --profile app)
WEARVERSE_DOMAIN=localhost
